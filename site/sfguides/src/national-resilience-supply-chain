2. Setup and Data Foundation
Create the database, schema, warehouse and internal stages for unstructured files:

CREATE DATABASE IF NOT EXISTS PACIFIC_SHIELD_DEMO;
CREATE SCHEMA IF NOT EXISTS PACIFIC_SHIELD_DEMO.SUPPLY_CHAIN;
USE DATABASE PACIFIC_SHIELD_DEMO;
USE SCHEMA SUPPLY_CHAIN;

CREATE WAREHOUSE IF NOT EXISTS NEXUS_WH
WAREHOUSE_SIZE = 'MEDIUM'
AUTO_SUSPEND = 60
AUTO_RESUME = TRUE;

CREATE STAGE IF NOT EXISTS AUDIT_DOCUMENTS
ENCRYPTION = (TYPE = 'SNOWFLAKE_SSE');

Core Tables
In production, data arrives via ingestion pipelines from agency procurement systems, logistics providers, IoT platforms, and third-party risk feeds. The core entities:

-- Programs the agency tracks for supply chain resilience
CREATE OR REPLACE TABLE PROGRAMS (
PROGRAM_ID VARCHAR(20) PRIMARY KEY,
PROGRAM_NAME VARCHAR(200),
SECTOR VARCHAR(30), -- DEFENSE, ENERGY, or MEDICAL
AGENCY VARCHAR(200),
CRITICALITY VARCHAR(20)
);

-- Supplier master with tiering, sourcing concentration, and risk score
CREATE OR REPLACE TABLE SUPPLIERS (
SUPPLIER_ID VARCHAR(20) PRIMARY KEY,
SUPPLIER_NAME VARCHAR(200),
COUNTRY VARCHAR(100),
REGION VARCHAR(100),
SECTOR VARCHAR(30),
TIER NUMBER(1), -- 1 = prime, 2 = sub-tier, 3 = raw material
IS_SINGLE_SOURCE BOOLEAN,
RISK_SCORE NUMBER(5,1), -- 0-100 composite risk score
LAST_INCIDENT_DATE DATE
);

-- Bill-of-materials: links component / facility / supplier to the programs that depend on it
CREATE OR REPLACE TABLE BILL_OF_MATERIALS (
BOM_ID VARCHAR(20) PRIMARY KEY,
PROGRAM_ID VARCHAR(20),
COMPONENT_ID VARCHAR(40),
COMPONENT_NAME VARCHAR(200),
SUPPLIER_ID VARCHAR(20),
FACILITY_ID VARCHAR(20), -- the specific manufacturing node — the unit of disruption
FACILITY_COUNTRY VARCHAR(100),
CRITICALITY VARCHAR(20),
LEAD_TIME_DAYS NUMBER(5,0),
ALT_SUPPLIER_ID VARCHAR(20),
ALT_LEAD_TIME_DAYS NUMBER(5,0),
ALT_CAPACITY_PCT NUMBER(5,1)
);

-- Procurement and logistics history
CREATE OR REPLACE TABLE PROCUREMENT_RECORDS ( /* supplier, component, order date, contract value */ );
CREATE OR REPLACE TABLE LOGISTICS_EVENTS ( /* shipment status, expected/actual date, delay days */ );
CREATE OR REPLACE TABLE IOT_SENSOR_READINGS ( /* container telemetry for in-transit shipments */ );
CREATE OR REPLACE TABLE QUALITY_INCIDENTS ( /* supplier quality events, last-90-days signal */ );

-- Third-party risk enrichment (Marketplace stand-in)
CREATE OR REPLACE TABLE MARKETPLACE_RISK_FEED (
FEED_ID VARCHAR(20) PRIMARY KEY,
REGION VARCHAR(100),
RISK_TYPE VARCHAR(30), -- WEATHER, GEOPOLITICAL, COMMODITY
RISK_SCORE NUMBER(5,1),
FEED_DATE DATE,
DESCRIPTION VARCHAR(500)
);

